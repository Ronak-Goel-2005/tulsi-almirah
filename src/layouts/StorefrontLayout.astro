          "url": "https://tulsi-almirah.onrender.com/",
          "publisher": { "@id": "https://tulsi-almirah.onrender.com/#showroom" }
        },
        {
          "@type": "FurnitureStore",
          "@id": "https://tulsi-almirah.onrender.com/#showroom",
          "name": "Tulsi Almirah",
          "url": "https://tulsi-almirah.onrender.com/",
