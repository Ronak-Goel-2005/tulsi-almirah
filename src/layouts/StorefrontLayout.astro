  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Explore Tulsi’s catalogue of steel almirahs, trunks, lockers, cabinets and shelving in Hind, Shamli. View photos, sizes and model codes.">
  <meta name="theme-color" content="#1a2a21">
  <title>Tulsi Almirah | Steel Almirah Showroom in Shamli</title>
  <link rel="canonical" href="https://tulsi-almirah.onrender.com/">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_IN">
  <meta property="og:site_name" content="Tulsi Almirah">
  <meta property="og:title" content="Tulsi Almirah | Steel Almirah Showroom in Shamli">
  <meta property="og:description" content="Browse the Tulsi catalogue of steel almirahs, trunks and other storage. Visit the showroom in Hind, Shamli.">
