            "addressRegion": "Uttar Pradesh",
            "postalCode": "247777",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 29.5230328,
            "longitude": 77.3778569
          },
          "hasMap": "https://www.google.com/maps?cid=12807746779321614385"
