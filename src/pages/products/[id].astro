---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { collections, collectionPath } from '../../data/collections';
import { products, type Product } from '../../data/products';
import { showroom } from '../../data/showroom';
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import { breadcrumbSchema, type Breadcrumb } from '../../lib/breadcrumbs';
import { productEnquiry, productPath } from '../../lib/catalogue';

export function getStaticPaths() {
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, photo, catalogueCode, dimensions, interiorPhoto, alternatePhoto } = product;
const isAlmirah = !product.categories.includes('storage');
const heading = isAlmirah ? `${name} Steel Almirah` : name;
const title = `${heading} | Tulsi Almirah, Shamli`;
const size = dimensions?.values.join(' × ');
const sizeSummary = isAlmirah && size ? ` ${size} inches (W × D × H).` : '';
const description = `${product.description}${sizeSummary} View photos and enquire at Tulsi Almirah in Shamli.`;
const site = Astro.site!;
const home = new URL('/', site).href;
const path = productPath(product.id);
const canonical = new URL(path, site).href;
const photoUrl = `/${photo.src}`;
const modelCollections = collections.filter(({ category }) => product.categories.includes(category));
const [primaryCollection, ...otherCollections] = modelCollections;
const breadcrumbs: Breadcrumb[] = [{ name: 'Home', path: '/' }];
if (primaryCollection) breadcrumbs.push({ name: primaryCollection.label, path: collectionPath(primaryCollection.id) });
breadcrumbs.push({ name: heading, path });
const modelCategory = product.categories.find((category) => category !== 'storage');
const relatedModels = products
  .filter((candidate) => candidate.id !== product.id && candidate.categories.some((category) => category === modelCategory))
  .sort((left, right) => Number(right.type === product.type) - Number(left.type === product.type))
  .slice(0, 3);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: heading,
      description,
      isPartOf: { '@id': `${home}#website` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        contentUrl: new URL(photoUrl, home).href,
        width: photo.width,
        height: photo.height,
      },
      breadcrumb: { '@id': `${canonical}#breadcrumbs` },
    },
    { ...breadcrumbSchema(breadcrumbs, site), '@id': `${canonical}#breadcrumbs` },
  ],
};
---

<StorefrontLayout {title} {description} image={{ ...photo, src: photoUrl }} {structuredData}>
  <SiteHeader />
  <main id="main" class="product-detail wrap" tabindex="-1">
    <Breadcrumbs items={breadcrumbs} />

    <div class="product-detail-grid">
      <div class="product-detail-copy">
        <p class="product-type">{product.type}</p>
        <h1>{heading}</h1>
        <p class="product-detail-description">{product.description}</p>

        {(size || catalogueCode) && (
          <dl class="model-specs">
            {size && (
              <div>
                <dt>{isAlmirah ? 'Width × depth × height' : 'Dimensions in catalogue order'}</dt>
                <dd>{isAlmirah ? `${size}''` : size}</dd>
              </div>
            )}
            {catalogueCode && <div><dt>Catalogue code</dt><dd>{catalogueCode}</dd></div>}
          </dl>
        )}

        <div class="actions">
          <a class="button button-green" href={productEnquiry(name, catalogueCode, isAlmirah)}>Ask on WhatsApp</a>
          <a class="button button-outline" href={`tel:${showroom.phone}`}>Call the shop</a>
        </div>

        <section class="product-detail-notes" aria-labelledby="catalogue-heading">
          <h2 id="catalogue-heading">Catalogue notes</h2>
          <p>{product.catalogueNote}</p>
          {dimensions && <p>Printed size {size} / {dimensions.catalogueSuffix}. The number after the slash is unlabelled in the brochure.</p>}
          <p>September 2025 catalogue, page {product.cataloguePage}.</p>
        </section>
        {relatedModels.length > 0 && (
          <section aria-labelledby="related-models-heading">
            <h2 id="related-models-heading">Similar models</h2>
            <ul class="related-models">
              {relatedModels.map((model) => (
                <li><a class="collection-jump" href={productPath(model.id)}>{model.name}{isAlmirah ? ' Steel Almirah' : ''}</a></li>
              ))}
            </ul>
          </section>
        )}
        <ul class="collection-links">
          {otherCollections.map(({ id, label }) => <li><a class="collection-jump" href={collectionPath(id)}>{label}</a></li>)}
          <li><a class="collection-jump" href={isAlmirah ? '/#collection' : '/#other-storage'}>
            {isAlmirah ? 'Browse all almirahs' : 'Browse all storage furniture'}
          </a></li>
        </ul>
      </div>

      <div class="product-detail-photos">
        <figure class="product-detail-photo product-detail-main-photo">
          <a href={photoUrl}>
            <img src={photoUrl} alt={photo.alt} width={photo.width} height={photo.height} fetchpriority="high">
          </a>
          <figcaption>{interiorPhoto ? 'Front view' : 'Catalogue photo'}</figcaption>
        </figure>
        {interiorPhoto && (
          <figure class="product-detail-photo">
            <a href={`/${interiorPhoto}`}>
              <img src={`/${interiorPhoto}`} alt={`Tulsi ${name} almirah, open view`} loading="lazy">
            </a>
            <figcaption>Inside view</figcaption>
          </figure>
        )}
        {alternatePhoto && (
          <figure class="product-detail-photo">
            <a href={`/${alternatePhoto.src}`}>
              <img src={`/${alternatePhoto.src}`} alt={`Tulsi ${name}: ${alternatePhoto.caption}`} loading="lazy">
            </a>
            <figcaption>{alternatePhoto.caption}</figcaption>
          </figure>
        )}
      </div>
    </div>
  </main>
  <SiteFooter />
</StorefrontLayout>
